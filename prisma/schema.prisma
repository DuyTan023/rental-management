/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model invoices {
  id                  BigInt           @id @default(autoincrement())
  contract_id         BigInt
  invoice_number      String           @unique @db.VarChar(50)
  billing_month       Int              @db.SmallInt
  billing_year        Int
  issue_date          DateTime         @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date            DateTime         @db.Date
  total_amount        Decimal          @default(0) @db.Decimal(15, 2)
  paid_amount         Decimal          @default(0) @db.Decimal(15, 2)
  status              invoice_status   @default(UNPAID)
  pdf_url             String?
  note                String?
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @default(now()) @db.Timestamptz(6)
  cancelled_at        DateTime?        @db.Timestamptz(6)
  cancellation_reason String?
  invoice_items       invoice_items[]
  rental_contracts    rental_contracts @relation(fields: [contract_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments            payments[]

  @@unique([contract_id, billing_month, billing_year], map: "uq_invoice_period_active", where: raw("(status <> 'CANCELLED'::invoice_status)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payments {
  id               BigInt         @id @default(autoincrement())
  invoice_id       BigInt
  payer_profile_id BigInt?
  created_by       BigInt?
  amount           Decimal        @db.Decimal(15, 2)
  payment_method   payment_method
  status           payment_status @default(PENDING)
  transaction_ref  String?        @db.VarChar(150)
  payos_order_code String?        @unique @db.VarChar(100)
  payment_date     DateTime?      @db.Timestamptz(6)
  note             String?
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @default(now()) @db.Timestamptz(6)
  users            users?         @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  invoices         invoices       @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles         profiles?      @relation(fields: [payer_profile_id], references: [id], onUpdate: NoAction)
}

enum account_role {
  LANDLORD
  TENANT
}

enum account_status {
  ACTIVE
  INACTIVE
  LOCKED
}

enum room_status {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum invitation_status {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum contract_tenant_role {
  REPRESENTATIVE
  MEMBER
}

enum contract_tenant_status {
  ACTIVE
  LEFT
}

enum rental_contract_status {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  COMPLETED
}

enum termination_requested_by {
  LANDLORD
  TENANT
  BOTH
}

enum deposit_status {
  NOT_RECEIVED
  RECEIVED
  REFUNDED
  PARTIALLY_DEDUCTED
  FULLY_DEDUCTED
  SETTLED
}

enum deposit_transaction_type {
  COLLECT
  REFUND
  DEDUCT
  ADJUSTMENT
}

enum meter_type {
  ELECTRICITY
  WATER
}

enum service_type {
  METERED
  FIXED_PER_MONTH
  FIXED_PER_HEAD
}

enum meter_reading_status {
  PENDING
  APPROVED
  REJECTED
}

enum invoice_status {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum payment_method {
  CASH
  BANK_TRANSFER
  PAYOS
}

enum payment_status {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}
