model room_services {
  id             BigInt    @id @default(autoincrement())
  room_id        BigInt
  service_id     BigInt
  unit_price     Decimal?  @db.Decimal(15, 2)
  effective_from DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  effective_to   DateTime? @db.Date
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  rooms          rooms     @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  services       services  @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([room_id, service_id, effective_from], map: "uq_room_service_period")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
